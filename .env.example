# Talumo environment configuration
# Copy to .env and adjust values

# OpenAI API key for LiteLLM remote models
OPENAI_API_KEY=sk-your-key-here

# Model location used by docker compose for llama-server router mode
LLAMA_MODEL_HOST_DIR=./models

# Router model loading limits
LLAMA_MODELS_MAX=2

# Model files referenced by config/llama_models.ini
# Keep these in sync with that preset file.
LLAMA_MODEL_FILE=model.gguf
LLAMA_MODEL_FILE_CODE=code.gguf

# CUDA / GPU support for llama-server
# Set to "true" to enable GPU acceleration (requires nvidia-container-toolkit)
ENABLE_CUDA=false

# GPU layers to offload (-1 = all layers, 0 = CPU only)
N_GPU_LAYERS=99
