# Zora environment configuration
# Copy to .env and adjust values

# OpenAI API key for LiteLLM remote models
OPENAI_API_KEY=sk-your-key-here

# CUDA / GPU support for llama-server
# Set to "true" to enable GPU acceleration (requires nvidia-container-toolkit)
ENABLE_CUDA=false

# GPU layers to offload (-1 = all layers, 0 = CPU only)
N_GPU_LAYERS=99
